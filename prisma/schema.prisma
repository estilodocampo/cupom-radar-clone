generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  affiliateId   String    @default("SEU_ID")
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  usage         PostUsage[]
  whatsapp      WhatsappConnection?
  scheduled     ScheduledPost[]
  dispatches    DispatchLog[]
  integrations  Integration[]
  feedbacks     Feedback[]
  radars        RadarConfig[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String   @default("gratuito")
  status            String   @default("active")
  abacateBillingId  String?
  currentPeriodEnd  DateTime?
  updatedAt         DateTime @updatedAt
}

model PostUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  count     Int      @default(0)

  @@unique([userId, day])
}

model WhatsappConnection {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("disconnected")
  phone     String?
  updatedAt DateTime @updatedAt
}

model ScheduledPost {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupJid    String
  groupName   String?
  message     String   @db.Text
  scheduledAt DateTime
  status      String   @default("pending")
  error       String?
  createdAt   DateTime @default(now())
}

model DispatchLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupJid  String
  message   String   @db.Text
  status    String
  kind      String?
  error     String?
  sentAt    DateTime @default(now())
}

// Fila: ofertas aguardando a janela de frequência (nada é descartado)
model QueuedOffer {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  targetJid String
  text      String    @db.Text
  mediaType String?
  media     String?   @db.Text
  fp        String
  status    String    @default("pending")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([userId, kind, fp, targetJid])
  @@index([status, createdAt])
}

model Integration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  url       String   @db.Text
  userId    String?
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, url])
}

// Radar Shopee: importação automática por palavras-chave/categorias
model RadarConfig {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String    @default("Meu radar")
  keywords        String[]  @default([])
  targetGroups    String[]  @default([])
  intervalMinutes Int       @default(120)
  maxPostsPerRun  Int       @default(3)
  active          Boolean   @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  posts           RadarPost[]

  @@index([userId])
}

model RadarPost {
  id      String      @id @default(cuid())
  radarId String
  radar   RadarConfig @relation(fields: [radarId], references: [id], onDelete: Cascade)
  itemKey String
  sentAt  DateTime    @default(now())

  @@unique([radarId, itemKey])
  @@index([radarId])
}
