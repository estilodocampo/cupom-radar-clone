# Copie para .env.migrate e preencha (o .env.migrate está no .gitignore)
# Railway → Postgres → Connect → Public Network
SOURCE_DATABASE_URL=postgresql://postgres:SENHA@HOST:PORT/railway

# Render → cupom-radar-db → Connect → External Database URL
TARGET_DATABASE_URL=postgresql://cupom_radar:SENHA@HOST:5432/cupom_radar
